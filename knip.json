{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.ts!",
    "public/ts/**/*.ts!"
  ],
  "project": [
    "src/**/*.ts!",
    "public/ts/**/*.ts!",
    "tests/**/*.ts"
  ],
  "ignore": [
    ".husky/**",
    "public/*.min.js",
    "public/bundle.js",
    "public/chat.js",
    "public/markdown-renderer.js",
    "public/script.js",
    "tests/api.test.ts"
  ],
  "ignoreDependencies": [
    "@types/tar",
    "@codemirror/*",
    "@lezer/*",
    "@vscode/ripgrep",
    "highlight.js",
    "lint-staged",
    "tree-sitter-c-sharp",
    "tree-sitter-cpp",
    "tree-sitter-javascript",
    "tree-sitter-typescript"
  ]
}
